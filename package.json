{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev-server.ts",
    "build": "vite build && tsx scripts/build-static-prerender.ts && esbuild prod-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prerender": "tsx scripts/build-static-prerender.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "record-voice": "tsx ../local-tools/media-studio/scripts/voice-studio-server.ts",
    "video:audio": "tsx ../local-tools/media-studio/scripts/generate-video-audio.ts",
    "video:render": "tsx ../local-tools/media-studio/scripts/render-explainer-video.ts",
    "video:mappack:render": "tsx ../local-tools/media-studio/scripts/render-mappack-video.ts",
    "video:mappack:audio": "../local-tools/media-studio/.venv/bin/python3 ../local-tools/media-studio/scripts/synthesize_mappack_audio.py",
    "video:publish": "tsx ../local-tools/media-studio/scripts/publish_social_video.ts",
    "social:auth": "tsx ../local-tools/media-studio/scripts/social_auth_helper.ts",
    "generate-reel": "tsx ../local-tools/media-studio/scripts/generate-reel.ts",
    "lint": "tsc --noEmit",
    "lint:a11y": "tsx ../local-tools/agents/skills/accessibility/scripts/audit_a11y.ts",
    "gsc:report": "tsx ../local-tools/seo-analytics/scripts/gsc_report.ts",
    "gsc:inspect": "tsx ../local-tools/seo-analytics/scripts/gsc_inspect.ts",
    "gsc:sitemaps": "tsx ../local-tools/seo-analytics/scripts/gsc_sitemaps.ts",
    "bing:report": "tsx ../local-tools/seo-analytics/scripts/bing_report.ts",
    "bing:submit": "tsx ../local-tools/seo-analytics/scripts/bing_submit.ts",
    "bing:sitemaps": "tsx ../local-tools/seo-analytics/scripts/bing_sitemaps.ts",
    "ga:report": "tsx ../local-tools/seo-analytics/scripts/ga4_report.ts",
    "youtube:report": "tsx ../local-tools/seo-analytics/scripts/youtube_report.ts",
    "brave:audit": "tsx ../local-tools/seo-analytics/scripts/brave_audit.ts",
    "audit:cwv": "tsx ../local-tools/seo-analytics/scripts/cwv_scan.ts",
    "sync:blogs": "tsx scripts/sync-blogs-supabase.ts",
    "trends": "tsx ../local-tools/seo-analytics/scripts/google_trends.ts",
    "tools:list": "tsx scripts/local-tools-bridge.ts list",
    "tools:add": "tsx scripts/local-tools-bridge.ts add",
    "tools:run": "tsx scripts/local-tools-bridge.ts run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.12.4",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "google-trends-api": "^4.9.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
